<!doctype html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="Candor Digital">
<meta property="og:locale" content="en_AU">
{% if shot %}<meta property="og:image" content="{{ site.url }}{{ shot }}">
<meta property="og:image:alt" content="{{ shotAlt }}">{% else %}<meta property="og:image" content="{{ site.url }}/assets/og-candor.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Candor Digital: marketing that tells you the truth. Social media, Meta ads, email and websites for Melbourne small businesses.">{% endif %}
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<script type="application/ld+json">
{{ schema | dump(1) | safe }}
</script>
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/fraunces-italic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="{{ bodyClass }}">

  <div class="scroll-progress" aria-hidden="true"><span id="scrollBar"></span></div>
  <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
  <div class="cursor-ring" id="cursorRing" aria-hidden="true"></div>

  <nav class="topbar">
    <div class="wrap">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 100 100" aria-hidden="true">
          <path id="markArc" class="mark-draw" d="M 81.69,54.45 A 32,32 0 1 1 81.69,45.55" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round"/>
          <line id="markBar" class="mark-draw" x1="62" y1="50" x2="95" y2="50" stroke="currentColor" stroke-width="10" stroke-linecap="round"/>
        </svg>
        <span class="brand-word">Candor<span class="brand-word-light"> Digital</span></span>
      </a>
      <div class="navlinks" id="navPill">
        <span class="tubelight" id="tubelight" aria-hidden="true"><span class="tubelight-lamp"></span></span>
        <a href="/" data-hover data-nav="home">Home</a>
        <a href="/about/" data-hover>About</a>
        <div class="nav-drop">
          <a href="/services/" data-hover aria-haspopup="true">Services <svg class="caret" viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></a>
          <div class="nav-menu" role="menu">
            {%- for s in collections.service %}
            <a href="{{ s.url }}" role="menuitem"><b>{{ s.data.service }}</b><span>{{ s.data.menuLine }}</span></a>
            {%- endfor %}
            <a href="/services/" role="menuitem" class="nav-menu-all">All services and how we work &rarr;</a>
          </div>
        </div>
        <a href="/work/" data-hover>Work</a>
        <a href="/pricing/" data-hover>Pricing</a>
        <a href="/contact/" data-hover>Contact</a>
      </div>
      <div class="nav-right">
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" data-hover>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
        </button>
        <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navPill"><span></span><span></span></button>
        <a class="nav-cta" href="/contact/" data-hover data-track="nav_cta">Free audit</a>
      </div>
    </div>
  </nav>

{{ content | safe }}

  <footer>
    <div class="wrap footer-row">
      <div class="footer-brand">
        <svg class="brand-mark" viewBox="0 0 100 100" width="18" height="18" role="button" tabindex="0" aria-label="Replay the Candor Digital logo animation" data-hover><path class="mark-draw" d="M 81.69,54.45 A 32,32 0 1 1 81.69,45.55" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round"/><line class="mark-draw" x1="62" y1="50" x2="95" y2="50" stroke="currentColor" stroke-width="10" stroke-linecap="round"/></svg>
        Candor Digital
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/services/social-media/">Social media</a>
        <a href="/services/meta-ads/">Meta ads</a>
        <a href="/services/email-marketing/">Email marketing</a>
        <a href="/services/websites/">Websites</a>
        <a href="/work/jagriti-verma/">Work</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="muted">Melbourne, Victoria &middot; working with businesses across Australia &middot; <a href="mailto:info@candordigital.com.au">info@candordigital.com.au</a></div>
    </div>
    <div class="footer-sig-wrap reveal" data-reveal aria-hidden="true">
      <svg class="footer-sig" viewBox="0 0 220 14">
        <path d="M4,9 Q40,2 80,9 T160,8 Q190,4 216,10" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
    </div>
  </footer>

<script src="/js/analytics.js" defer></script>
<script src="/js/main.js" defer></script>
</body>
</html>
