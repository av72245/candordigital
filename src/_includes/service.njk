---
layout: base.njk
bodyClass: page-inner page-service
---
{% include "page-hero.njk" %}

<section class="split-section">
  <div class="wrap">
    <div class="section-head reveal" data-reveal>
      <div class="section-tag"><span class="tag-spark" aria-hidden="true"></span><span class="tag-text">what you get</span></div>
      <h2>{{ includedHeading }}</h2>
      <p class="muted">{{ includedIntro }}</p>
    </div>
    <div class="included-grid">
      {% for item in included %}
      <article class="principle reveal" data-reveal>
        <h3>{{ item.t }}</h3>
        <p>{{ item.d }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="approach alt-band">
  <div class="wrap">
    <div class="section-head reveal" data-reveal>
      <div class="section-tag"><span class="tag-spark" aria-hidden="true"></span><span class="tag-text">how it runs</span></div>
      <h2>{{ stepsHeading or "How it works, step by step" }}</h2>
    </div>
    <div class="timeline" id="timeline">
      <div class="timeline-line"><span class="timeline-fill" id="timelineFill"></span></div>
      {% for st in steps %}
      <div class="timeline-item reveal" data-reveal>
        <div class="timeline-dot">{{ loop.index }}</div>
        <div><h3>{{ st.t }}</h3><p class="muted">{{ st.d }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section>
  <div class="wrap two-col">
    <div class="reveal" data-reveal>
      <div class="section-tag"><span class="tag-spark" aria-hidden="true"></span><span class="tag-text">a good fit if</span></div>
      <h2>Who this is for</h2>
      <ul class="check-list">{% for x in fitFor %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>
    <div class="reveal" data-reveal style="transition-delay:.08s">
      <div class="section-tag"><span class="tag-spark" aria-hidden="true"></span><span class="tag-text">the honest part</span></div>
      <h2>Not a fit if</h2>
      <ul class="cross-list">{% for x in notFor %}<li>{{ x }}</li>{% endfor %}</ul>
      <p class="muted small">{{ costNote | safe }}</p>
    </div>
  </div>
</section>

{% include "faq-block.njk" %}

<section class="related">
  <div class="wrap">
    <div class="section-head"><h2>Pairs well with</h2></div>
    <div class="cards cards--3">
      {% for r in collections.service %}{% if r.url != page.url %}
      <article class="card">
        <h3>{{ r.data.service }}</h3>
        <p>{{ r.data.short }}</p>
        <a class="card-more" href="{{ r.url }}" data-hover>Learn more <span aria-hidden="true">&rarr;</span></a>
      </article>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

{% include "cta-band.njk" %}
