<form class="lead-form" name="audit-request" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company_website" id="auditForm">
  <input type="hidden" name="form-name" value="audit-request">
  <p class="hp-field" aria-hidden="true"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off"></label></p>

  <div class="field-row">
    <label class="field">
      <span>Name <em aria-hidden="true">*</em></span>
      <input type="text" name="name" autocomplete="name" required>
    </label>
    <label class="field">
      <span>Business name</span>
      <input type="text" name="business" autocomplete="organization">
    </label>
  </div>
  <div class="field-row">
    <label class="field">
      <span>Email <em aria-hidden="true">*</em></span>
      <input type="email" name="email" autocomplete="email" required>
    </label>
    <label class="field">
      <span>Phone</span>
      <input type="tel" name="phone" autocomplete="tel" placeholder="04XX XXX XXX">
    </label>
  </div>
  <label class="field">
    <span>What do you need help with?</span>
    <select name="interest">
      <option value="">Not sure yet</option>
      <option>Social media management</option>
      <option>Meta ads (Facebook &amp; Instagram)</option>
      <option>Email marketing</option>
      <option>A new website</option>
      <option>The $450 four-week trial</option>
    </select>
  </label>
  <label class="field">
    <span>Anything we should know?</span>
    <textarea name="message" rows="3" placeholder="Your website or Instagram, what's working, what isn't..."></textarea>
  </label>
  <button type="submit" class="btn btn-primary btn-lg magnetic" data-hover><span>Book my free audit</span></button>
  <p class="form-note muted">We only use your details to reply to you.</p>
</form>
