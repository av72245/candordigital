{% include "page-hero.njk" %}
<section>
  <div class="wrap">
    <div class="cards services-hub">
      {% for s in collections.service %}
      <article class="card reveal" data-reveal>
        <h3>{{ s.data.service }}</h3>
        <p>{{ s.data.short }}</p>
        <ul class="mini-list">{% for i in s.data.included | batch(3) | first %}<li>{{ i.t }}</li>{% endfor %}</ul>
        <a class="card-more" href="{{ s.url }}" data-hover>Learn more <span aria-hidden="true">&rarr;</span></a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="alt-band" id="process">
  <div class="wrap">
    <div class="section-head reveal" data-reveal>
      <div class="section-tag"><span class="tag-spark" aria-hidden="true"></span><span class="tag-text">how it really starts</span></div>
      <h2>Our process: four steps, not a funnel</h2>
      <p class="muted">The same approach for every service, so you always know what's happening, what it costs and what's next.</p>
    </div>
    <div class="timeline" id="timeline">
